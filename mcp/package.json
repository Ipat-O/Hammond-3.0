{
  "name": "hammond-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "Local stdio MCP adapter for Hammond (HAM3-015) — a thin client of Hammond's local HTTP agent-access API. Implements no domain logic of its own.",
  "type": "module",
  "bin": {
    "hammond-mcp": "./dist/hammond-mcp.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "package:sea": "node scripts/package-sea.mjs",
    "verify:sea": "node scripts/verify-sea.mjs",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.4",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
